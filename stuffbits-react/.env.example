# Google Maps API key - enables live traffic layer on footer map
# Get key from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API
VITE_GOOGLE_MAPS_API_KEY=your_api_key_here

# Contact form endpoint (Google Apps Script Web App)
# See google-apps-script/README.md for setup. Paste your Web app URL after deployment.
# Example: https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
VITE_CONTACT_FORM_URL=

# Optional: Jobs API endpoint (Google Sheets or any JSON API)
# This should return an array of job rows or { data: [...] }.
# Example: https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
VITE_JOBS_API_URL=

# Job application form - Google Apps Script Web App (see google-apps-script/JobApplication.gs)
# Handles: POST applications, stores in Sheet, emails company + applicant
# GET with ?action=getApplicants returns applicant list for the Applicants tab
# Example: https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
VITE_JOB_APPLICATION_FORM_URL=

# Optional LinkedIn feed embed on /news-and-events (below StuffBits event cards).
# From EmbedSocial / Taggbox / similar: create LinkedIn company feed widget → copy iframe src URL only.
# VITE_LINKEDIN_EVENTS_FEED_IFRAME_SRC=https://...
# Optional iframe height in px (default 920)
# VITE_LINKEDIN_EVENTS_FEED_HEIGHT=920

# Or: Elfsight “LinkedIn Feed” widget — paste app UUID from Elfsight dashboard
# VITE_ELFSIGHT_LINKEDIN_APP_ID=
